# Include inside the server block of the Nginx site to instrument.
# Only trust X-ExeDev-Email when your upstream proxy overwrites it.
set $inject_script "";
if ($http_x_exedev_email = @EMAIL@) {
    set $inject_script @SCRIPT@;
}
sub_filter_types text/html;
sub_filter '</body>' '$inject_script</body>';
sub_filter_once on;

location = /__shelley_inject/inject.js {
    if ($http_x_exedev_email != @EMAIL@) { return 403; }
    alias @ROOT@/assets/inject.js;
    add_header Cache-Control "private, no-store" always;
}
location /__shelley_inject/preview/ {
    if ($http_x_exedev_email != @EMAIL@) { return 403; }
    client_max_body_size 512k;
    proxy_pass http://127.0.0.1:@API_PORT@;
    proxy_buffering off;
    proxy_read_timeout 3600s;
}
location /__shelley_inject/shelley-api/ {
    if ($http_x_exedev_email != @EMAIL@) { return 403; }
    client_max_body_size 25m;
    rewrite ^/__shelley_inject/shelley-api/(.*)$ /api/$1 break;
    proxy_pass http://127.0.0.1:@SHELLEY_PORT@;
    proxy_set_header X-ExeDev-UserID @USER_ID@;
    proxy_set_header X-ExeDev-Email @EMAIL@;
    proxy_set_header Host $host;
    proxy_buffering off;
    proxy_read_timeout 3600s;
}
location /__shelley_inject/ { return 404; }
