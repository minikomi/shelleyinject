worker_processes 1;
pid @ROOT@/run/nginx.pid;
error_log stderr;
events { worker_connections 128; }
http {
    include /etc/nginx/mime.types;
    access_log off;
    client_body_temp_path @ROOT@/run/body;
    fastcgi_temp_path @ROOT@/run/fastcgi;
    uwsgi_temp_path @ROOT@/run/uwsgi;
    scgi_temp_path @ROOT@/run/scgi;
    proxy_temp_path @ROOT@/run/proxy;
    map $http_x_exedev_email $inject_allowed { default 0; @EMAIL@ 1; }
    map $inject_allowed $inject_script { default ""; 1 @SCRIPT@; }
    server {
        listen 127.0.0.1:@SITE_PORT@;
        root @ROOT@/site;
        location / { try_files $uri $uri/ =404; }
    }
    server {
        listen @LISTEN@:@PORT@;
        include @ROOT@/run/adapter.conf;
    }
    server {
        listen 127.0.0.1:@DEV_PORT@;
        set $inject_allowed 1;
        set $inject_script @SCRIPT@;
        include @ROOT@/run/adapter.conf;
    }
}
